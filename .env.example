# Değerleri kendi .env dosyanıza yazın. Bu dosya gizli anahtar içermez.
MONGODB_URI=mongodb://127.0.0.1:27017/bahceni
PORT=3000
# En az 32 rastgele karakter. Üretim modunda zorunlu.
SESSION_SECRET=
# iyzico sandbox hesabından alınır. İkisi yoksa açıkça etiketli demo ödeme kullanılır.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# iyzico yönlendirmesi için dışarıdan erişilebilir HTTPS adresi
APP_URL=
# Opsiyonel: İlk süper admini hosting panelinden oluşturmak için. Oluşunca kaldırın.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opsiyonel: e-posta bildirimi (SMTP). Boşsa yalnızca site içi bildirim gider.
# Gmail için: smtp.gmail.com, 465, Gmail adresi ve Google "Uygulama şifresi" (normal şifre değil).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
